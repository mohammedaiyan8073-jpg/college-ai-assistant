<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Assistant</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f4f7fb;
      margin: 0;
      padding: 20px;
    }

    .box {
      max-width: 700px;
      margin: 40px auto;
      background: white;
      padding: 30px;
      border-radius: 15px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    h1 {
      text-align: center;
    }

    input {
      width: 100%;
      padding: 14px;
      box-sizing: border-box;
      margin: 15px 0;
      border: 1px solid #ccc;
      border-radius: 8px;
    }

    button {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 8px;
      background: #2636c9;
      color: white;
      font-size: 16px;
    }

    #response {
      margin-top: 20px;
      padding: 15px;
      background: #eef0ff;
      border-radius: 8px;
    }
  </style>
</head>

<body>

  <div class="box">
    <h1>🤖 College AI Assistant</h1>

    <p>Ask a question about your studies:</p>

    <input id="question" placeholder="Type your question...">

    <button onclick="answerQuestion()">Ask AI</button>

    <div id="response">
      Your AI response will appear here.
    </div>
  </div>

  <script>
    function answerQuestion() {
      const question = document.getElementById("question").value;
      const response = document.getElementById("response");

      if (question.trim() === "") {
        response.innerText = "Please type a question first.";
        return;
      }

      response.innerText =
        "AI Response: You asked — " + question +
        ". This is a demonstration AI assistant for the college assignment.";
    }
  </script>

</body>
</html>
